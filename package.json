{
  "name": "runcanvas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:next": "next dev --turbo",
    "build": "turbo run build",
    "build:next": "next build",
    "start": "next start",
    "lint": "turbo run lint",
    "lint:next": "next lint",
    "test": "turbo run test",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@turf/turf": "^7.0.0",
    "mapbox-gl": "^3.1.2",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/mapbox-gl": "^3.1.0",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
