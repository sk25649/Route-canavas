# Mapbox Tokens
# Get your tokens at: https://account.mapbox.com/

# Public token for client-side map display (starts with pk.)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR_PUBLIC_TOKEN_HERE

# Secret token for server-side API calls (starts with sk.)
# This is used for the Map Matching API (road snapping)
MAPBOX_SECRET_TOKEN=sk.YOUR_SECRET_TOKEN_HERE
